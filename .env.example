# Image Search API Keys (all optional, script uses free sources first)

# Firecrawl - last resort, costs tokens
FIRECRAWL_API_KEY=your_firecrawl_key

# Pixabay - free tier available at https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_key

# Pexels - free at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key

# Unsplash - free at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_key
